# .env.example

# Server
PORT=8080
ENV=development

# CORS — comma-separated allowed origins (the frontend dev/prod URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# In-memory rate limiting (per Cloud Run instance)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST=30
# Optional locally; production deploy expects the existing Redis Cloud URL.
REDIS_URL=rediss://default:password@redis-host:port

# Database (Supabase) — use the Session pooler (IPv4). NOT the direct
# db.[ref].supabase.co:5432 host, which is IPv6-only.
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require

# JWT (our own backend-issued tokens)
JWT_SECRET=your-secret-key-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h   # 30 days (Supabase session is the durable fallback layer)

# Supabase — tokens are verified via the project's public JWKS
# ({SUPABASE_URL}/auth/v1/.well-known/jwks.json), so no signing secret is needed.
SUPABASE_URL=https://[ref].supabase.co

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_ACCESS_KEY_SECRET=
R2_BUCKET_NAME=checkpoint-app
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Reverse geocoding (OpenStreetMap Nominatim)
GEOCODER_ENABLED=true
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=checkpoint-app/0.1

# GCP
GCP_PROJECT_ID=
# Pub/Sub topic for async media processing (video transcode). Leave empty to
# process media inline (local dev). See backend/DEPLOY.md §5.7.
PUBSUB_TOPIC=
# Worker only: optional shared secret required on the Pub/Sub push endpoint
# (?token=<value>), in addition to Cloud Run IAM.
WORKER_PUSH_TOKEN=

# LocationIQ — used for check-in nearby place suggestions (GET /places/suggest).
# Free tier: 5,000 req/day. Leave empty to disable (fallback to Photon address).
LOCATIONIQ_API_KEY=
